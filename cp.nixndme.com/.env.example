# Copy to .env (git-ignored) and fill in. Never commit .env.

# Public origin used in share links and QR codes.
CP_BASE_URL=https://cp.example.com

# Login account, used ONLY on first boot (when the database is empty).
# Leave the password empty to have one generated and printed once in the container log.
CP_ADMIN_USER=admin
CP_ADMIN_PASSWORD=

# Behind Cloudflare Tunnel: trust CF-Connecting-IP for the login lockout, and mark cookies Secure.
CP_TRUST_PROXY=true
CP_SECURE_COOKIES=true

# Limits
CP_MAX_FILE_MB=100
CP_STORAGE_CAP_MB=5120
CP_MAX_FILES_PER_SHARE=20
CP_CHUNK_MB=8

# Live transfer: STUN servers that help two browsers find each other (no file data goes there).
# Comma-separated; "none" = local network addresses only. Default: stun:stun.cloudflare.com:3478
# CP_LIVE_STUN=none

# Live transfer relay (coturn on the Pi, the "turn" compose profile). Used only when two devices
# cannot connect directly, e.g. a laptop firewall drops incoming traffic. Home network only.
# Leave all of these unset to run without a relay. See README "Relay".
# CP_LIVE_TURN=turn:<pi-lan-ip>:3478?transport=udp,turn:<pi-lan-ip>:3478?transport=tcp
# Shared by cp and the relay; letters and digits only, at least 32: openssl rand -hex 32
# CP_LIVE_TURN_SECRET=
# The relay listens only on this address (the Pi's LAN IP) ...
# CP_TURN_LISTEN_IP=<pi-lan-ip>
# ... and only forwards to this range (your home network), as first-last address.
# CP_TURN_ALLOWED_PEERS=192.168.0.0-192.168.0.255
# CP_TURN_PORT=3478
# CP_TURN_MIN_PORT=49160
# CP_TURN_MAX_PORT=49200

# Host side (docker compose)
CP_PORT=8090
CP_DATA_PATH=./data
# Run as your host user so ./data stays writable (id -u / id -g).
CP_UID=1000
CP_GID=1000
# Optional: keep the encryption key outside the data disk, e.g. on the Pi's SD card:
# CP_KEY_FILE=/key/secret.key   (and mount that directory in compose.yml)

# Image (always pulled from Docker Hub) and the dedicated Cloudflare Tunnel container.
CP_IMAGE=nixndme/cp:latest
# Add ",turn" to also run the Live transfer relay: COMPOSE_PROFILES=tunnel,turn
# Add ",home" to also run the start page (README "Hidden sign-in"): COMPOSE_PROFILES=tunnel,home
COMPOSE_PROFILES=tunnel
CP_TUNNEL_DIR=./tunnel

# Start page (profile home). cp proxies it under /home; strangers see it at / once a secret word
# is set in Settings. Its config is deploy/home/glance.yml, copied to CP_HOME_CONFIG_DIR.
# CP_HOME_UPSTREAM=http://home:8080
# CP_HOME_CONFIG_DIR=./home
# Two weather tabs. The NAME is shown on the start page (public), so pick what you are fine showing.
# CP_HOME_WEATHER_NAME=Your City
# CP_HOME_WEATHER_LOCATION=Your City, Country
# CP_HOME_WEATHER_2_NAME=Other City
# CP_HOME_WEATHER_2_LOCATION=Other City, Country
# "My Reddit" tab: your front page. Copy the "Your front page" RSS link from reddit.com/prefs/feeds
# (it has your username and a private key: anyone with it can read that feed). Unset: r/popular.
# CP_HOME_REDDIT_FEED=https://www.reddit.com/.rss?feed=<key>&user=<you>
# Where other searches go ({QUERY} = the search):
# CP_SEARCH_URL=https://duckduckgo.com/?q={QUERY}
