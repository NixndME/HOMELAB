# Copy to .env (git-ignored) and fill in. Read by setup.sh and clients.sh.
PI_SSH=user@pi-lan-ip          # SSH target of the Pi
PI_IP=pi-lan-ip                # LAN IP AdGuard binds DNS to and serves the dashboard on
AGH_USER=admin-username        # AdGuard Home admin user
AGH_PASSWORD_FILE=~/.config/homelab/adguard-admin.pw   # file holding the admin password (mode 600)
